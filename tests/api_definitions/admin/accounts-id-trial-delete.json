{
  "name": "DELETE /api/admin/accounts/:id/trial - Cancel a trial early",
  "endpoint": "/api/admin/accounts/:id/trial",
  "method": "DELETE",
  "description": "Ends an active trial immediately and reverts the account to the free plan. MUTATING, so the Authorization header carries the step-up token — auth is orthogonal to HTTP method, DELETE needs it too. Runs after the trial-grant test, which creates the trial this cancels.",
  "requiresAuth": true,
  "expectedStatus": 200,
  "priority": 42,
  "testCases": [
    {
      "name": "Cancel the active trial",
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.step-up.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:auth.register.response.data.user.id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "plan": "free"
        }
      }
    },
    {
      "name": "400 INVALID_ACCOUNT_ID — The :id path parameter is not a valid UUID",
      "testType": "negative",
      "coversErrorCase": "400|invalid_account_id",
      "expectedStatus": 400,
      "expectedError": {
        "code": "INVALID_ACCOUNT_ID"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.step-up.response.data.token}}"
      },
      "pathParams": {
        "id": "{{static:not-a-uuid}}"
      }
    },
    {
      "name": "403 STEP_UP_REQUIRED — The Authorization header carries a plain admin session token rather than an elevated step-up token",
      "testType": "negative",
      "coversErrorCase": "403|step_up_required",
      "expectedStatus": 403,
      "expectedError": {
        "code": "STEP_UP_REQUIRED"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.login.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:auth.register.response.data.user.id}}"
      }
    },
    {
      "name": "404 NO_ACTIVE_TRIAL — The subscription status is not 'trialing'",
      "testType": "negative",
      "coversErrorCase": "404|no_active_trial",
      "expectedStatus": 404,
      "expectedError": {
        "code": "NO_ACTIVE_TRIAL"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.step-up.response.data.token}}"
      },
      "pathParams": {
        "id": "{{static:11111111-1111-1111-1111-111111111111}}"
      }
    }
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/admin/auth/login",
    "POST /api/admin/auth/step-up",
    "POST /api/admin/accounts/:id/trial"
  ],
  "taskId": "a7d58441-99d4-4224-8b02-96306862b103",
  "sprintId": "729f9fe5-b963-4444-8b0e-f82bd555d110",
  "featureId": "dfbaba08-d363-41ab-8631-4af9139fc2cc",
  "epicId": "5efe9e03-3c39-47f9-8080-94442bc51813",
  "errorCases": [
    {
      "status": 400,
      "code": "INVALID_ACCOUNT_ID",
      "message": "Invalid account id",
      "when": "The :id path parameter is not a valid UUID"
    },
    {
      "status": 403,
      "code": "STEP_UP_REQUIRED",
      "message": "Step-up verification required for this action",
      "when": "The Authorization header carries a plain admin session token rather than an elevated step-up token"
    },
    {
      "status": 404,
      "code": "NO_ACTIVE_TRIAL",
      "message": "This account has no active trial",
      "when": "The subscription status is not 'trialing'"
    },
    {
      "status": 500,
      "code": "TRIAL_CANCEL_FAILED",
      "message": "Failed to cancel trial",
      "when": "Unexpected server error"
    }
  ]
}
