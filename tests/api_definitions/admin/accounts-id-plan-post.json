{
  "name": "POST /api/admin/accounts/:id/plan - Manual plan override",
  "endpoint": "/api/admin/accounts/:id/plan",
  "method": "POST",
  "description": "Applies a comp/manual plan change. MUTATING, so the Authorization header carries the step-up token, NOT the login token. Delegates to SubscriptionService.createOrUpdateSubscription so the subscriptions row, users.plan and the current month's usage limit move together, then flags the row as a manual override. Returns a warning when the account has a live Stripe subscription, because a future webhook will overwrite the override.\n\nThe happy path raises the fixture account to 'solo'. Raising a limit cannot break other tests in the suite; lowering one could, so the downgrade path is left to the integration tests which own their own fixtures.",
  "requiresAuth": true,
  "expectedStatus": 200,
  "priority": 32,
  "testCases": [
    {
      "name": "Override plan to solo",
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.step-up.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:auth.register.response.data.user.id}}"
      },
      "payload": {
        "plan": "{{static:solo}}",
        "reason": "{{dynamic:text}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "plan": "solo",
          "is_manual_override": true
        }
      }
    },
    {
      "name": "400 INVALID_ACCOUNT_ID — The :id path parameter is not a valid UUID",
      "testType": "negative",
      "coversErrorCase": "400|invalid_account_id",
      "expectedStatus": 400,
      "expectedError": {
        "code": "INVALID_ACCOUNT_ID"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.step-up.response.data.token}}"
      },
      "pathParams": {
        "id": "{{static:not-a-uuid}}"
      },
      "payload": {
        "plan": "{{static:solo}}",
        "reason": "{{dynamic:text}}"
      }
    },
    {
      "name": "400 INVALID_PLAN — plan is missing or not a recognised plan",
      "testType": "negative",
      "coversErrorCase": "400|invalid_plan",
      "expectedStatus": 400,
      "expectedError": {
        "code": "INVALID_PLAN"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.step-up.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:auth.register.response.data.user.id}}"
      },
      "payload": {
        "plan": "{{static:enterprise}}",
        "reason": "{{dynamic:text}}"
      }
    },
    {
      "name": "400 REASON_REQUIRED — reason is missing or blank",
      "testType": "negative",
      "coversErrorCase": "400|reason_required",
      "expectedStatus": 400,
      "expectedError": {
        "code": "REASON_REQUIRED"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.step-up.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:auth.register.response.data.user.id}}"
      },
      "payload": {
        "plan": "{{static:solo}}"
      }
    },
    {
      "name": "403 STEP_UP_REQUIRED — The Authorization header carries a plain admin session token rather than an elevated step-up token",
      "testType": "negative",
      "coversErrorCase": "403|step_up_required",
      "expectedStatus": 403,
      "expectedError": {
        "code": "STEP_UP_REQUIRED"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.login.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:auth.register.response.data.user.id}}"
      },
      "payload": {
        "plan": "{{static:solo}}",
        "reason": "{{dynamic:text}}"
      }
    },
    {
      "name": "404 ACCOUNT_NOT_FOUND — No account exists with that id",
      "testType": "negative",
      "coversErrorCase": "404|account_not_found",
      "expectedStatus": 404,
      "expectedError": {
        "code": "ACCOUNT_NOT_FOUND"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.step-up.response.data.token}}"
      },
      "pathParams": {
        "id": "{{static:11111111-1111-1111-1111-111111111111}}"
      },
      "payload": {
        "plan": "{{static:solo}}",
        "reason": "{{dynamic:text}}"
      }
    }
  ],
  "fieldEnums": {
    "plan": [
      "free",
      "solo",
      "team",
      "scale"
    ]
  },
  "statusTransitions": {
    "free -> solo|team|scale": "POST /api/admin/accounts/:id/plan (manual override)",
    "any -> free": "POST /api/admin/accounts/:id/plan with plan=free, or Stripe subscription cancellation"
  },
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/admin/auth/login",
    "POST /api/admin/auth/step-up"
  ],
  "taskId": "3b15766d-9782-4fec-84c9-1e861b861dae",
  "sprintId": "729f9fe5-b963-4444-8b0e-f82bd555d110",
  "featureId": "0fac4905-ba67-4ce4-98b7-366c8c4c6c11",
  "epicId": "5efe9e03-3c39-47f9-8080-94442bc51813",
  "errorCases": [
    {
      "status": 400,
      "code": "INVALID_ACCOUNT_ID",
      "message": "Invalid account id",
      "when": "The :id path parameter is not a valid UUID"
    },
    {
      "status": 400,
      "code": "INVALID_PLAN",
      "message": "plan must be one of free, solo, team, scale",
      "when": "plan is missing or not a recognised plan"
    },
    {
      "status": 400,
      "code": "REASON_REQUIRED",
      "message": "A reason is required and is recorded in the audit log",
      "when": "reason is missing or blank"
    },
    {
      "status": 403,
      "code": "STEP_UP_REQUIRED",
      "message": "Step-up verification required for this action",
      "when": "The Authorization header carries a plain admin session token rather than an elevated step-up token"
    },
    {
      "status": 404,
      "code": "ACCOUNT_NOT_FOUND",
      "message": "Account not found",
      "when": "No account exists with that id"
    },
    {
      "status": 500,
      "code": "OVERRIDE_FAILED",
      "message": "Failed to override plan",
      "when": "Unexpected server error"
    }
  ]
}
