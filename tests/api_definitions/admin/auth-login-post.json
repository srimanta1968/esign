{
  "name": "POST /api/admin/auth/login - Platform admin login",
  "endpoint": "/api/admin/auth/login",
  "method": "POST",
  "description": "Authenticates a platform_admin and issues a short-TTL admin session token. This is the ONLY public route under /api/admin — it provides auth rather than requiring it. Tenant-level 'admin' users are rejected with 403.",
  "requiresAuth": false,
  "expectedStatus": 200,
  "priority": 10,
  "setupScript": "platform_admin.sql",
  "testCases": [
    {
      "name": "Platform admin logs in with seeded credentials",
      "payload": {
        "email": "{{var:platform_admin_email}}",
        "password": "{{var:platform_admin_password}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "token": "string",
          "admin": {
            "role": "platform_admin"
          }
        }
      }
    }
  ],
  "captureResponse": {
    "admin.auth.login.response.data.token": "data.token",
    "admin.auth.login.response.data.admin.id": "data.admin.id"
  },
  "fieldEnums": {
    "role": ["user", "admin", "viewer", "guest", "platform_admin"]
  },
  "taskId": "1403c2d1-4165-465c-87e2-a252eb372727",
  "sprintId": "729f9fe5-b963-4444-8b0e-f82bd555d110"
}
