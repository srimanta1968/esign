{
  "name": "POST /api/admin/accounts/:id/credits - Grant or revoke bonus credits",
  "endpoint": "/api/admin/accounts/:id/credits",
  "method": "POST",
  "description": "Grants or revokes bonus document credits. MUTATING, so the Authorization header carries the step-up token, NOT the login token. Credits sit on top of the plan quota — the monthly allowance is always consumed first and credits only apply once it is exhausted. Reason is mandatory and recorded in the append-only ledger with the acting admin. Revoking more than the balance clamps to zero rather than going negative.\n\nFor a team member the credits are held by the TEAM OWNER, because team usage is tracked against the owner's quota.",
  "requiresAuth": true,
  "expectedStatus": 200,
  "priority": 36,
  "testCases": [
    {
      "name": "Grant 25 bonus credits",
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.step-up.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:auth.register.response.data.user.id}}"
      },
      "payload": {
        "action": "{{static:grant}}",
        "amount": 25,
        "reason": "{{dynamic:text}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "action": "grant"
        }
      }
    },
    {
      "name": "400 INVALID_ACCOUNT_ID — The :id path parameter is not a valid UUID",
      "testType": "negative",
      "coversErrorCase": "400|invalid_account_id",
      "expectedStatus": 400,
      "expectedError": {
        "code": "INVALID_ACCOUNT_ID"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.step-up.response.data.token}}"
      },
      "pathParams": {
        "id": "{{static:not-a-uuid}}"
      },
      "payload": {
        "action": "{{static:grant}}",
        "amount": 25,
        "reason": "{{dynamic:text}}"
      }
    },
    {
      "name": "400 INVALID_ACTION — action is missing or not a recognised value",
      "testType": "negative",
      "coversErrorCase": "400|invalid_action",
      "expectedStatus": 400,
      "expectedError": {
        "code": "INVALID_ACTION"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.step-up.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:auth.register.response.data.user.id}}"
      },
      "payload": {
        "action": "{{static:not_a_real_action}}",
        "amount": 25,
        "reason": "{{dynamic:text}}"
      }
    },
    {
      "name": "400 REASON_REQUIRED — reason is missing or blank",
      "testType": "negative",
      "coversErrorCase": "400|reason_required",
      "expectedStatus": 400,
      "expectedError": {
        "code": "REASON_REQUIRED"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.step-up.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:auth.register.response.data.user.id}}"
      },
      "payload": {
        "action": "{{static:grant}}",
        "amount": 25
      }
    },
    {
      "name": "400 INVALID_AMOUNT — amount is zero, negative or fractional",
      "testType": "negative",
      "coversErrorCase": "400|invalid_amount",
      "expectedStatus": 400,
      "expectedError": {
        "code": "INVALID_AMOUNT"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.step-up.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:auth.register.response.data.user.id}}"
      },
      "payload": {
        "action": "{{static:grant}}",
        "amount": 0,
        "reason": "{{dynamic:text}}"
      }
    },
    {
      "name": "400 INVALID_EXPIRY — expires_at is supplied but unparseable",
      "testType": "negative",
      "coversErrorCase": "400|invalid_expiry",
      "expectedStatus": 400,
      "expectedError": {
        "code": "INVALID_EXPIRY"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.step-up.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:auth.register.response.data.user.id}}"
      },
      "payload": {
        "action": "{{static:grant}}",
        "amount": 25,
        "reason": "{{dynamic:text}}",
        "expires_at": "{{static:not-a-date}}"
      }
    },
    {
      "name": "403 STEP_UP_REQUIRED — The Authorization header carries a plain admin session token rather than an elevated step-up token",
      "testType": "negative",
      "coversErrorCase": "403|step_up_required",
      "expectedStatus": 403,
      "expectedError": {
        "code": "STEP_UP_REQUIRED"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.login.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:auth.register.response.data.user.id}}"
      },
      "payload": {
        "action": "{{static:grant}}",
        "amount": 25,
        "reason": "{{dynamic:text}}"
      }
    },
    {
      "name": "404 ACCOUNT_NOT_FOUND — No account exists with that id",
      "testType": "negative",
      "coversErrorCase": "404|account_not_found",
      "expectedStatus": 404,
      "expectedError": {
        "code": "ACCOUNT_NOT_FOUND"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.step-up.response.data.token}}"
      },
      "pathParams": {
        "id": "{{static:11111111-1111-1111-1111-111111111111}}"
      },
      "payload": {
        "action": "{{static:grant}}",
        "amount": 25,
        "reason": "{{dynamic:text}}"
      }
    }
  ],
  "fieldEnums": {
    "action": [
      "grant",
      "revoke"
    ],
    "source": [
      "admin_grant",
      "admin_revoke",
      "consumption",
      "expiry"
    ]
  },
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/admin/auth/login",
    "POST /api/admin/auth/step-up"
  ],
  "taskId": "f10af679-211c-4e37-9481-ff7b87515b1d",
  "sprintId": "729f9fe5-b963-4444-8b0e-f82bd555d110",
  "featureId": "dfbaba08-d363-41ab-8631-4af9139fc2cc",
  "epicId": "5efe9e03-3c39-47f9-8080-94442bc51813",
  "errorCases": [
    {
      "status": 400,
      "code": "INVALID_ACCOUNT_ID",
      "message": "Invalid account id",
      "when": "The :id path parameter is not a valid UUID"
    },
    {
      "status": 400,
      "code": "INVALID_ACTION",
      "message": "action must be 'grant' or 'revoke'",
      "when": "action is missing or not a recognised value"
    },
    {
      "status": 400,
      "code": "REASON_REQUIRED",
      "message": "A reason is required and is recorded in the audit log",
      "when": "reason is missing or blank"
    },
    {
      "status": 400,
      "code": "INVALID_AMOUNT",
      "message": "Credit amount must be a positive whole number",
      "when": "amount is zero, negative or fractional"
    },
    {
      "status": 400,
      "code": "INVALID_EXPIRY",
      "message": "expires_at must be a valid date",
      "when": "expires_at is supplied but unparseable"
    },
    {
      "status": 403,
      "code": "STEP_UP_REQUIRED",
      "message": "Step-up verification required for this action",
      "when": "The Authorization header carries a plain admin session token rather than an elevated step-up token"
    },
    {
      "status": 404,
      "code": "ACCOUNT_NOT_FOUND",
      "message": "Account not found",
      "when": "No account exists with that id"
    },
    {
      "status": 500,
      "code": "CREDITS_CHANGE_FAILED",
      "message": "Failed to change credits",
      "when": "Unexpected server error"
    }
  ]
}
