{
  "name": "GET /api/admin/accounts/:id - Full account detail",
  "endpoint": "/api/admin/accounts/:id",
  "method": "GET",
  "description": "Aggregate view of one account: profile, access state with reason and who changed it, subscription, trailing usage, team membership, document and workflow counts, and recent admin actions taken against it. password_hash is never selected. Read-only, so no step-up elevation required.",
  "requiresAuth": true,
  "expectedStatus": 200,
  "priority": 22,
  "testCases": [
    {
      "name": "Get detail for a registered account",
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.login.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:auth.register.response.data.user.id}}"
      },
      "expectedStatus": 200,
      "expectedResponse": {
        "success": true,
        "data": {
          "account": {
            "access_status": "active"
          }
        }
      }
    },
    {
      "name": "400 INVALID_ACCOUNT_ID — The :id path parameter is not a valid UUID",
      "testType": "negative",
      "coversErrorCase": "400|invalid_account_id",
      "expectedStatus": 400,
      "expectedError": {
        "code": "INVALID_ACCOUNT_ID"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.login.response.data.token}}"
      },
      "pathParams": {
        "id": "{{static:not-a-uuid}}"
      }
    },
    {
      "name": "401 AUTH_REQUIRED — No Authorization header is present",
      "testType": "negative",
      "coversErrorCase": "401|auth_required",
      "expectedStatus": 401,
      "expectedError": {
        "code": "AUTH_REQUIRED"
      },
      "pathParams": {
        "id": "{{cache:auth.register.response.data.user.id}}"
      }
    },
    {
      "name": "403 NOT_PLATFORM_ADMIN — The caller is authenticated but is not a platform_admin (a tenant-level admin is refused here)",
      "testType": "negative",
      "coversErrorCase": "403|not_platform_admin",
      "expectedStatus": 403,
      "expectedError": {
        "code": "NOT_PLATFORM_ADMIN"
      },
      "headers": {
        "Authorization": "Bearer {{cache:auth.register.response.data.token}}"
      },
      "pathParams": {
        "id": "{{cache:auth.register.response.data.user.id}}"
      }
    },
    {
      "name": "404 ACCOUNT_NOT_FOUND — No account exists with that id",
      "testType": "negative",
      "coversErrorCase": "404|account_not_found",
      "expectedStatus": 404,
      "expectedError": {
        "code": "ACCOUNT_NOT_FOUND"
      },
      "headers": {
        "Authorization": "Bearer {{cache:admin.auth.login.response.data.token}}"
      },
      "pathParams": {
        "id": "{{static:11111111-1111-1111-1111-111111111111}}"
      }
    }
  ],
  "dependsOn": [
    "POST /api/auth/register",
    "POST /api/admin/auth/login"
  ],
  "taskId": "4a3858c6-8029-4874-8811-e9785fd1756e",
  "sprintId": "729f9fe5-b963-4444-8b0e-f82bd555d110",
  "featureId": "322fe5ad-9b19-4ed0-af34-9fb7e6a4f81b",
  "epicId": "5efe9e03-3c39-47f9-8080-94442bc51813",
  "errorCases": [
    {
      "status": 400,
      "code": "INVALID_ACCOUNT_ID",
      "message": "Invalid account id",
      "when": "The :id path parameter is not a valid UUID"
    },
    {
      "status": 401,
      "code": "AUTH_REQUIRED",
      "message": "Access token required",
      "when": "No Authorization header is present"
    },
    {
      "status": 403,
      "code": "NOT_PLATFORM_ADMIN",
      "message": "Platform administrator access required",
      "when": "The caller is authenticated but is not a platform_admin (a tenant-level admin is refused here)"
    },
    {
      "status": 403,
      "code": "ACCESS_REVOKED",
      "message": "Platform administrator access has been revoked",
      "when": "The admin's own access_status is suspended or revoked",
      "reproducible": false,
      "notReproducibleReason": "Requires revoking the acting administrator's own access, which would break every subsequent admin test in the run. Covered by the adminAuthBoundary integration test, which owns its own fixture."
    },
    {
      "status": 404,
      "code": "ACCOUNT_NOT_FOUND",
      "message": "Account not found",
      "when": "No account exists with that id"
    },
    {
      "status": 500,
      "code": "DETAIL_FAILED",
      "message": "Failed to load account detail",
      "when": "Query error"
    }
  ]
}
